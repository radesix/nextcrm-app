# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# PostgreSQL connection string (required).
# Default: the local Docker Postgres from docker-compose.dev.yml (`pnpm db:up`).
DATABASE_URL="postgresql://nextcrm:nextcrm@localhost:5433/nextcrm"
# Remote databases go here too — this file, never `.env.local`, because the
# Prisma CLI reads only `.env`. Keep the local line above and comment/uncomment:
#DATABASE_URL="postgresql://<username>:<password>@<host>:<port>/<database>?schema=public"
# Note: `pnpm db:migrate`, `db:seed` and `db:reset` refuse to run unless this
# points at localhost (scripts/assert-local-db.sh).

# Optional. The connection string the *runtime* pool (lib/prisma.ts) uses, when
# it should differ from DATABASE_URL. On Supabase+Vercel, point this at the
# **transaction** pooler (:6543) so warm serverless instances multiplex instead
# of exhausting the session pooler (EMAXCONNSESSION). DATABASE_URL stays on the
# **session** pooler (:5432) for `prisma migrate deploy`. Blank/unset → the
# runtime falls back to DATABASE_URL (no behavior change). Leave empty locally
# (no transaction pooler in the local stack). See SUPABASE_ON_VERCEL.md §3.
RUNTIME_DATABASE_URL=

# Max pg connections PER function instance (lib/prisma.ts). Caps the pool so a
# serverless cold-start fan-out can't exhaust the hosted session-mode pooler
# (EMAXCONNSESSION → every page 500s). Empty/invalid falls back to 3; never set
# to 1 (deadlocks multi-query renders). See docs/guides/platform/SUPABASE_ON_VERCEL.md §3.
DB_POOL_MAX=3

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_ID="your-google-client-id"
GOOGLE_SECRET="your-google-client-secret"

# Email Service (Resend). Leave the key empty to use the one saved in
# Admin > Resend; an env value always wins over the admin panel.
RESEND_API_KEY=
EMAIL_FROM=                # verified sender for login codes, e.g. noreply@yourdomain.com

# AI. Leave empty to use keys saved in the admin panel.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Firecrawl (contact enrichment)
FIRECRAWL_API_KEY=            # get from https://firecrawl.dev

# MinIO / S3 object storage
# MINIO_ENDPOINT is what the server uses; MINIO_PUBLIC_ENDPOINT is what
# browsers use (presigned uploads and file links). Leave it empty when both
# are the same URL.
MINIO_ENDPOINT="https://your-minio-host"
MINIO_PUBLIC_ENDPOINT=
MINIO_BUCKET="your-bucket-name"
MINIO_ACCESS_KEY="your-access-key"
MINIO_SECRET_KEY="your-secret-key"

# Encrypts stored mailbox passwords and API keys — generate with: openssl rand -hex 32
# Set once and never change it, or the stored values become unreadable.
EMAIL_ENCRYPTION_KEY=

# Campaigns — Resend email sending
RESEND_WEBHOOK_SECRET=     # Resend webhook signing secret (whsec_…, Svix-signed)
RESEND_FROM_EMAIL=         # e.g. noreply@yourdomain.com

# Google Calendar sync — Workspace-internal OAuth app
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ═════════════════════════════════════════════════════════════════════════════
# Rade Engineering fork additions (WS4)
# Keys READ by application code but missing from upstream's block above. Kept in
# a separate section so upstream's stays byte-identical (merge-friendly). Every
# key here is documented in docs/reference/ENVIRONMENT_VARIABLES.md — the env-doc
# guard (scripts/check-env-docs.sh) fails CI if the two ever drift apart.
# ═════════════════════════════════════════════════════════════════════════════

# ── Background jobs (Inngest) ──
INNGEST_ID="nextcrm"
INNGEST_APP_NAME="NextCRM"
INNGEST_EVENT_KEY=          # optional locally (Inngest dev server needs none)
INNGEST_SIGNING_KEY=        # optional locally; required in QA/prod

# ── Cache / rate-limiting (Upstash Redis) ──
# Enrichment rate-limiting is skipped when unset in non-prod; both required when active.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Transactional email (nodemailer path, lib/sendmail.ts) ──
EMAIL_HOST=
EMAIL_USERNAME=
EMAIL_PASSWORD=
MAILTRAP_API_KEY=           # optional; falls back to a DB-stored service key

# ── Campaign email (Resend) — segregated from transactional ──
# Dedicated Resend key for CAMPAIGN sends (domain-restricted to the campaigns
# sending domain, tracking on). Transactional email uses RESEND_API_KEY above.
# Falls back to RESEND_API_KEY if unset. RESEND_FROM_EMAIL / RESEND_WEBHOOK_SECRET
# (upstream block) are the campaigns sender + tracking-webhook secret.
RESEND_CAMPAIGNS_API_KEY=
# Physical mailing address printed in the branded campaign email footer
# (CAN-SPAM requirement). Read by lib/campaigns/brand.ts. Set per deployment;
# when unset the footer omits the address line.
CAMPAIGN_MAILING_ADDRESS=   # e.g. "Rade Engineering, 123 Main St, City, ST 00000"

# ── Non-prod email safety ──
# When set, ALL outbound recipients are rewritten to this one test inbox (dev/QA),
# so real Resend sends never reach real people. Set in Development + Preview (QA)
# only; leave UNSET in Production (and it never redirects a prod deploy anyway).
EMAIL_REDIRECT_TO=

# ── AI providers (optional; each falls back to a DB-stored key via lib/api-keys.ts) ──
# (ANTHROPIC_API_KEY / EMAIL_FROM now live in upstream's block above)
GROQ_API_KEY=
# Homepage AI imagery — primary image provider (optional; fail-open). Holds "<key-id>:<key-secret>".
# Unset => falls back to OPENAI_API_KEY (image fallback), then text-only. Never required.
HIGGSFIELD_API_KEY=

# ── Contact enrichment (E2B sandbox) ──
E2B_API_KEY=
E2B_ENRICHMENT_TEMPLATE=    # optional; defaults to "nextcrm-enrichment"

# ── Public lead intake + campaign unsubscribe URLs ──
NEXTCRM_TOKEN=              # bearer token guarding the public create-lead endpoints
WEB_LEAD_ASSIGNEE_EMAIL=    # optional; user (by email) that web-form leads are assigned to. Defaults to shaun@radeengineering.com
ASSISTANT_TOKEN=            # bearer token for POST /api/crm/assistant/inquiry (AI chat/voice via n8n); >=32 chars, separate from NEXTCRM_TOKEN. Unset = endpoint rejects all calls
NEXTAUTH_URL="http://localhost:3000"   # base URL for campaign unsubscribe links

# ── SSRF guard (lib/net/host-guard.ts) ──
MAIL_ALLOW_PRIVATE_HOSTS=   # leave empty; "true" only to allow private hosts (dev). NEVER set in Preview/Production
PLUGIN_HTTP_ALLOW_PRIVATE_HOSTS=   # upstream plugin HTTP client (lib/plugins/http.ts); same rule — leave empty, NEVER "true" in Preview/Production

# ── MCP SSE transport (optional) ──
# /api/mcp SSE needs Redis; unset = SSE returns 501, the HTTP transport still works.
REDIS_URL=
KV_URL=

# ── Homepage previews (AI homepage generation) ──
# Public base URL the prospect-facing previews are served from (e.g. https://previews.radeengineering.com).
# OPTIONAL / fail-closed: unset = the generate job still stores the page but leaves preview_url null (feature degrades).
# The pages live in the EXISTING private R2 bucket (MINIO_*) under previews/ — no new bucket or credentials.
NEXT_PUBLIC_PREVIEWS_BASE_URL=

# ── Object storage public URL (upstream dropped it from its block in v0.36; still read as a fallback) ──
NEXT_PUBLIC_MINIO_ENDPOINT="https://your-minio-host"

# ── App identity / public branding (NEXT_PUBLIC_* are bundled to the browser) ──
NEXT_PUBLIC_APP_NAME="NextCRM"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_DOMAIN="localhost:3000"
NEXT_PUBLIC_NEXT_VERSION=
NEXT_PUBLIC_DISCORD_INVITE_URL="#"
NEXT_PUBLIC_GITHUB_REPO_URL="#"
NEXT_PUBLIC_GITHUB_ISSUES_URL="#"
NEXT_PUBLIC_GITHUB_REPO_API=   # e.g. https://api.github.com/repos/<owner>/<repo>
# Seed the demo CRM dataset on `pnpm db:seed` (1 = yes)
SEED_DEMO_DATA=
